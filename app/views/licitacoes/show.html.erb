<div class="row justify-content-center my-4">
  <div class="col-md-8">
    
    <!-- Cabeçalho com Botão de Voltar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="h4 fw-bold text-dark mb-0">Detalhes da Dispensa</h1>
      <%= link_to '← Voltar para a Lista', licitacoes_path, class: 'btn btn-outline-secondary btn-sm' %>
    </div>

    <!-- Card Principal de Detalhes -->
    <div class="card shadow-sm border-0">
      <div class="card-header bg-dark text-white py-3">
        <h5 class="mb-0">Edital: <span class="text-warning"><%= @licitacao.numero %></span></h5>
      </div>
      
      <div class="card-body p-4">
        
        <div class="mb-3">
          <label class="fw-bold text-muted small d-block">ÓRGÃO PÚBLICO RESPONSÁVEL</label>
          <span class="fs-5 text-dark"><%= @licitacao.orgao %></span>
        </div>

        <hr class="text-muted">

        <div class="mb-3">
          <label class="fw-bold text-muted small d-block">OBJETO DA CONTRATAÇÃO</label>
          <p class="fs-6 text-secondary bg-light p-3 rounded border"><%= @licitacao.objeto %></p>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="fw-bold text-muted small d-block">VALOR ESTIMADO</label>
            <span class="fs-5 fw-bold text-success">
              <%= number_to_currency(@licitacao.valor, unit: "R$ ", separator: ",", delimiter: ".") %>
            </span>
          </div>

          <div class="col-md-6 mb-3">
            <label class="fw-bold text-muted small d-block">DATA DE ABERTURA / PUBLICAÇÃO</label>
            <span class="fs-6 text-dark"><%= @licitacao.data_abertura.strftime("%d/%m/%Y às %H:%M") %></span>
          </div>
        </div>

      </div>
      
      <div class="card-footer bg-light text-end py-3">
        <span class="text-muted small">ID interno do registro no sistema: #<%= @licitacao.id %></span>
      </div>
    </div>

  </div>
</div>